# =============================================================================
# Line-ending normalization — canonical policy (fleet-wide)
# All text files are stored as LF in the repo. Windows-only script types that
# their interpreter requires as CRLF are pinned to CRLF. Binaries are untouched.
# After adding/updating this file, run:  git add --renormalize .
# =============================================================================

# Default: treat everything as text, normalize to LF in the repo.
* text=auto eol=lf

# ---- Explicit LF (Linux hosts run these; must be LF) ----
*.sh        text eol=lf
*.bash      text eol=lf
*.sql       text eol=lf
*.cron      text eol=lf
*.cron.template text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.toml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.env       text eol=lf

# ---- Windows-native: PowerShell interpreter expects CRLF ----
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.bat       text eol=crlf
*.cmd       text eol=crlf

# ---- Binary: never touch ----
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.gz        binary
*.db        binary
*.sqlite    binary
*.pyc       binary
*.woff2     binary
*.woff      binary
