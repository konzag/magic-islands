# magic-islands: environment variable NAMES and safe defaults. No secrets exist for this app.
# Copy to .env for local dev. On the VMs infra writes /opt/magic-islands/.env (provision-apps).

ENVIRONMENT=dev            # prod | staging | dev | test (prod/staging hide /docs)
LOG_LEVEL=INFO
PORT=8087

# /metrics is served only to these direct (non-proxied) peers: the Prometheus host (monitor).
METRICS_ALLOW_IPS=192.168.1.11

# OpenTelemetry (off by default)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.11:4317

# Optional overrides for /version (auto-deploy reads the git checkout otherwise)
# BUILD_SHA=
# BUILD_TIME=
